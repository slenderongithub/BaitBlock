{
  "name": "clickbait-detection-webapp",
  "version": "2.1.0",
  "description": "Web app that scores a news article URL for clickbait, misleading headlines, weak sourcing and manipulation, with an explainable six-dimension breakdown.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "train:headline": "node scripts/train-headline-model.js"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.0.0",
    "compromise": "^14.17.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "fast-xml-parser": "^5.9.3",
    "helmet": "^8.2.0",
    "ipaddr.js": "^2.4.0",
    "linkedom": "^0.18.13",
    "playwright": "^1.61.1",
    "robots-parser": "^3.0.1",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.5"
  }
}
